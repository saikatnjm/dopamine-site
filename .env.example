# Public base URL of the site. Used for canonical URLs, OG tags and share links.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
# Leave empty to disable analytics; the site works normally without it.
NEXT_PUBLIC_GA_ID=

# Optional contact address shown on About/Privacy. Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
